{
  "name": "ets-vibes",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @ets-vibes/desktop dev",
    "build": "pnpm --filter @ets-vibes/desktop build",
    "check-types": "pnpm --filter @ets-vibes/desktop check-types",
    "check": "oxlint && oxfmt --write",
    "lint": "vp lint",
    "format": "vp fmt",
    "staged": "vp staged",
    "prepare": "husky",
    "cargo:check": "cargo check --workspace",
    "cargo:fmt": "cargo fmt --all --check",
    "cargo:clippy": "cargo clippy --workspace --all-targets -- -D warnings",
    "cargo:build": "cargo build --workspace",
    "tauri": "pnpm --filter @ets-vibes/desktop tauri"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@ets-vibes/config": "workspace:*",
    "@types/node": "^22.13.14",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "oxfmt": "^0.57.0",
    "oxlint": "^1.72.0",
    "rolldown": "1.1.4",
    "typescript": "^7.0.2",
    "vite-plus": "0.2.2"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.2"
  },
  "lint-staged": {
    "*": [
      "oxlint",
      "oxfmt --write"
    ],
    "*.rs": [
      "cargo fmt -- --check",
      "cargo clippy -- -D warnings"
    ]
  },
  "packageManager": "pnpm@11.11.0"
}
